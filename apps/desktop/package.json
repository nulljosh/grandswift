{
  "name": "grandswift",
  "productName": "Grand Swift",
  "version": "1.6.0",
  "description": "A crime game set in Vancouver",
  "main": "main.js",
  "author": {
    "name": "Joshua Trommel",
    "email": "trommatic@icloud.com"
  },
  "license": "MIT",
  "scripts": {
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jaybulb.grandswift",
    "icon": "../../site/icon.png",
    "win": {
      "target": "nsis"

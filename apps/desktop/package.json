    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "Joshua Trommel <trommatic@icloud.com>"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "homepage": "https://grandswift.heyitsmejosh.com"
}
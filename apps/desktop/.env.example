# Export these in your shell or CI; electron-builder does not load this file.
# macOS: Developer ID Application certificate (.p12).
CSC_LINK=/absolute/path/to/developer-id.p12
CSC_KEY_PASSWORD=REPLACE_WITH_CERTIFICATE_PASSWORD
# Windows: Authenticode certificate (.pfx).
WIN_CSC_LINK=/absolute/path/to/windows-signing.pfx
WIN_CSC_KEY_PASSWORD=REPLACE_WITH_CERTIFICATE_PASSWORD
# macOS notarization (app-specific Apple ID password).
APPLE_ID=REPLACE_WITH_APPLE_ID
APPLE_APP_SPECIFIC_PASSWORD=REPLACE_WITH_APP_SPECIFIC_PASSWORD
APPLE_TEAM_ID=REPLACE_WITH_TEAM_ID
